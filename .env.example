NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Firebase Admin credentials
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Sheet source
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_NAME=list1
GOOGLE_SHEET_GID=your-sheet-gid

# Every day at 12:00 and 18:00 (Moscow)
CRON_ENABLED=true
CRON_SCHEDULE=0 12,18 * * *
CRON_TZ=Europe/Moscow
# /status reports import_stale when no successful import for this long (cron enabled only)
IMPORT_MAX_AGE_HOURS=19
CORS_ORIGIN=http://127.0.0.1:5173
# Channel feed with the daily CNY rate; in prod - the Cloudflare Worker proxy to t.me/s/elvnpay
CNY_RATE_SOURCE_URL=https://t.me/s/elvnpay

# Optional alerts to Telegram
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Telegram API base URL; set to a relay URL where api.telegram.org is blocked
ALERT_TELEGRAM_API_URL=https://api.telegram.org

# Optional manual trigger token (x-job-token header)
JOB_TOKEN=

# Firebase Auth UIDs allowed to set client passwords (same list as isAdmin() in Firestore rules), comma-separated
ADMIN_UIDS=
